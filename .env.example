# Optional: comma-separated @usernames allowed to run /new (empty = anyone in control chat)
# ALLOWED_NEW_USERNAMES=realcryptomoses,muzandv
# ALLOWED_NEW_USER_IDS=

# Optional: Telegram channel id for success/audit logs (bot must be admin). Example: -1001234567890
# LOG_CHANNEL_ID=

# Optional: restrict /new to one group chat id
# CONTROL_GROUP_ID=-3999467199

# Railway / cloud: base64 of session/group_automation.session (do not commit the .session file)
# TELETHON_SESSION_BASE64=
